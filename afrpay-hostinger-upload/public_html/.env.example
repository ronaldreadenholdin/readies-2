# AfrPay Hostinger live config
# Copy this file to .env and fill values

AFRPAY_BASE_URL=
AFRPAY_API_KEY=
AFRPAY_AUTH_SCHEME=bearer
AFRPAY_WEBHOOK_SECRET=
AFRPAY_TIMEOUT_SECONDS=30

# Keep false until pre-flight is green
AFRPAY_LIVE_ENABLED=false
AFRPAY_TEST_APPROVED=false
AFRPAY_OR001_TEST_APPROVED=false
AFRPAY_OB003_TEST_APPROVED=false
AFRPAY_TEST_APPROVED_BY=
AFRPAY_TEST_APPROVED_AT=

# OR001 Onramp
AFRPAY_ONRAMP_BASE_URL=
AFRPAY_ONRAMP_API_KEY=
AFRPAY_ONRAMP_WEBHOOK_SECRET=
AFRPAY_ONRAMP_SIGNATURE_HEADER=X-AfrPay-Signature
AFRPAY_ONRAMP_CREATE_PATH=/v1/onramp/payments
AFRPAY_ONRAMP_STATUS_PATH=/v1/onramp/payments/{reference}
AFRPAY_ONRAMP_REFUND_PATH=/v1/onramp/refunds
AFRPAY_OR001_FORCE_SANDBOX_CALLS=false

# OB003 Open Banking
AFRPAY_OPEN_BANKING_BASE_URL=
AFRPAY_OPEN_BANKING_API_KEY=
AFRPAY_OPEN_BANKING_WEBHOOK_SECRET=
AFRPAY_OPEN_BANKING_SIGNATURE_HEADER=X-AfrPay-Bank-Signature
AFRPAY_OPEN_BANKING_CREATE_PATH=/v1/open-banking/payments
AFRPAY_OPEN_BANKING_STATUS_PATH=/v1/open-banking/payments/{reference}
AFRPAY_OPEN_BANKING_REFUND_PATH=/v1/open-banking/refunds
AFRPAY_OB003_FORCE_SANDBOX_CALLS=false
